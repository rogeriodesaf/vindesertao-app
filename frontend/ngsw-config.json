{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "appData": {
    "version": "territory-distribution-offline-v3"
  },
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "offline-city-map",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/maps/rio-tinto-pb.pmtiles",
          "/assets/maps/joao-pessoa-pb.pmtiles"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|png|jpg|webp)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "offline-visit-photos",
      "urls": [
        "https://res.cloudinary.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "30d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/q/**"
  ]
}
